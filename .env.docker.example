# Copy thành .env.docker rồi sửa giá trị thật. Không commit file .env.docker.
# Dùng: docker compose --env-file .env.docker up -d --build
#
# MÔ HÌNH MẶC ĐỊNH (1 VPS + Caddy ngoài của bạn):
#   backend :3000, admin :8080, client :8081, objectstore :9000 — Caddy ngoài trỏ
#   3 domain về 3 port này. Đặt BIND_ADDR=0.0.0.0 nếu Caddy ở máy khác.
# ALL-IN-ONE: thêm  --profile edge  để bật Caddy nội bộ (HTTPS tự động),
#   khi đó dùng API_DOMAIN/ADMIN_DOMAIN/CLIENT_DOMAIN bên dưới.

# IP bind các port (127.0.0.1 = chỉ trong máy; 0.0.0.0 = mở LAN/internet + firewall)
BIND_ADDR=127.0.0.1

# Domain cho profile edge / Caddy ngoài (VD api.example.com)
API_DOMAIN=api.example.com

# Trang quan tri: domain that (VD admin.example.com) hoac test noi bo http://127.0.0.1:8080
ADMIN_DOMAIN=admin.example.com
# API ma trang quan tri goi. Doi cai nay phai build lai admin.
# 1 VPS: http://127.0.0.1:3000/api (local) hoặc https://api.example.com/api (domain)
ADMIN_API_BASE=https://api.example.com/api
# File (anh/video) ma trang quan tri hien. Doi cung phai build lai admin
ADMIN_FILES_BASE=https://api.example.com/files/unimate

# Web ban hang: domain that (VD www.example.com) hoac test noi bo http://127.0.0.1:8081
CLIENT_DOMAIN=www.example.com
# API + file ma web goi. Doi phai build lai client
CLIENT_API_BASE=https://api.example.com/api
CLIENT_FILES_BASE=https://api.example.com/files/unimate

# Domain frontend được phép gọi API, cách nhau dấu phẩy.
# BẮT BUỘC ghi đủ cả 2 dạng localhost và 127.0.0.1 — thiếu một dạng thì trang
# đó bị CORS chặn và hiện trang trắng.
ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# MySQL (đặt chuỗi mạnh, khác nhau). Backend ở máy khác: mở ports mysql + DB_HOST=<ip>
MYSQL_ROOT_PASSWORD=doi-root-manh-o-day
MYSQL_USER=unimate
MYSQL_PASSWORD=doi-app-manh-o-day
# DB_HOST=mysql
# DB_PORT=3306

# JWT (chuỗi ngẫu nhiên >= 32 ký tự). Tạo nhanh:  openssl rand -hex 32
JWT_SECRET=thay-bang-chuoi-ngau-nhien-32-ky-tu-tro-len

# Tài khoản quản trị khởi tạo — CHỈ dùng lần đầu, khi database còn trống.
# Sau lần đó script sẽ bỏ qua, nên đổi mật khẩu trong trang quản trị sẽ được giữ nguyên.
#   ADMIN_EMAIL     email đăng nhập
#   ADMIN_PASSWORD  tối thiểu 12 ký tự. Để TRỐNG -> sinh mật khẩu ngẫu nhiên in ra log:
#                   docker compose --env-file .env.docker logs backend
#   ADMIN_NAME      tên hiển thị
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Object storage: RustFS nội bộ (mặc định) hoặc S3/R2 ngoài (đổi S3_ENDPOINT + keys)
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=doi-rustfs-manh-o-day
# S3_ENDPOINT=http://objectstore:9000
S3_BUCKET=unimate
# URL công khai mà trình duyệt thấy.
# Qua Caddy ngoài (prod): https://api.example.com/files/unimate
# Test local (RustFS trực tiếp): http://127.0.0.1:9000/unimate
S3_PUBLIC_URL=https://api.example.com/files/unimate
S3_MAX_IMAGE_MB=10
S3_MAX_VIDEO_MB=100
S3_MAX_FILE_MB=20

# SMTP gui email marketing (Gmail: host smtp.gmail.com, port 587 + App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Test local HTTP thuần (không TLS): bật 2 dòng dưới
# FORCE_HTTPS=0
# COOKIE_SECURE=0
