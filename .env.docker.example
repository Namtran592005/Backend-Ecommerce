# Copy thành .env.docker rồi sửa giá trị thật. Không commit file .env.docker.
# Dùng: docker compose --env-file .env.docker up -d --build

# Domain API trỏ về IP máy chủ (VD api.example.com). Test nội bộ: http://localhost
API_DOMAIN=api.example.com

# Trang quan tri: domain that (VD admin.example.com) hoac test noi bo http://127.0.0.1:8080
ADMIN_DOMAIN=admin.example.com
# API ma trang quan tri goi (phai khop API_DOMAIN + /api). Doi cai nay phai build lai admin
ADMIN_API_BASE=https://api.example.com/api

# Domain frontend được phép gọi API, cách nhau dấu phẩy
ALLOWED_ORIGINS=https://shop.example.com

# MySQL (đặt chuỗi mạnh, khác nhau)
MYSQL_ROOT_PASSWORD=doi-root-manh-o-day
MYSQL_USER=unimate
MYSQL_PASSWORD=doi-app-manh-o-day

# JWT (chuỗi ngẫu nhiên >= 32 ký tự). Tạo nhanh:  openssl rand -hex 32
JWT_SECRET=thay-bang-chuoi-ngau-nhien-32-ky-tu-tro-len

# Object storage MinIO (S3-compatible) cho ảnh/media
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=doi-minio-manh-o-day
S3_BUCKET=unimate
# URL công khai mà trình duyệt thấy (trùng domain API + /files/<bucket>)
S3_PUBLIC_URL=https://api.example.com/files/unimate
S3_MAX_IMAGE_MB=10
S3_MAX_VIDEO_MB=100
S3_MAX_FILE_MB=20

# SMTP gui email marketing (Gmail: host smtp.gmail.com, port 587 + App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Chỉ dùng khi test local bằng http:// (không TLS). Deploy domain thật: để nguyên 2 dòng = 1
# FORCE_HTTPS=0
# COOKIE_SECURE=0
