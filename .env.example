PORT=3000
NODE_ENV=production
# Domain frontend được phép gọi API, cách nhau dấu phẩy (KHÔNG để * khi lên prod)
ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com
# Bật khi chạy sau Nginx/Cloudflare đã có HTTPS
FORCE_HTTPS=1
TRUST_PROXY=1
COOKIE_SECURE=1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=unimate_app
DB_PASSWORD=mat-khau-manh-rieng-cho-app
DB_NAME=unimate
# Chuỗi ngẫu nhiên dài >= 32 ký tự, mỗi môi trường một giá trị khác nhau
JWT_SECRET=thay-bang-chuoi-ngau-nhien-32-ky-tu-tro-len
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
