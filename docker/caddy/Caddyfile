# Caddy reverse proxy cho UniMate API + Admin.
# - API_DOMAIN=api.example.com     → Caddy tự xin & gia hạn HTTPS (Let's Encrypt)
# - API_DOMAIN=http://localhost    → chạy HTTP thuần (chỉ dùng để test nội bộ)
# - ADMIN_DOMAIN=admin.example.com → trang quản trị (HTTPS tự động)
# - ADMIN_DOMAIN=http://127.0.0.1:8080 → test nội bộ qua cổng 8080
{
	admin off
}

{$API_DOMAIN} {
	# File công khai từ object storage: https://API_DOMAIN/files/unimate/<key>
	handle /files/* {
		uri strip_prefix /files
		reverse_proxy objectstore:9000
	}
	handle {
		reverse_proxy backend:3000
	}
}

{$ADMIN_DOMAIN} {
	reverse_proxy admin:80
}

{$CLIENT_DOMAIN} {
	reverse_proxy client:80
}
